# Copiá este archivo como .env y completá los valores. NUNCA subas .env al repositorio.

# Clave secreta de Django. Generá una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

# 1 = desarrollo (muestra errores), 0 = producción. En el servidor real debe ser 0.
DJANGO_DEBUG=1

# Dominios/IPs permitidos, separados por coma. Ej: rrhh.empresa.local,192.168.1.50
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes de confianza para formularios (CSRF) cuando se usa HTTPS. Ej: https://rrhh.empresa.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# URL base del sistema, usada para armar los links de invitación absolutos.
# Ej: http://192.168.1.50:8000  o  https://rrhh.empresa.local
DJANGO_SITE_URL=http://127.0.0.1:8000

# Clave para cifrar los documentos en disco (32 bytes url-safe base64).
# Generá una con:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DOCUMENTOS_ENCRYPTION_KEY=

# Poné 1 en el servidor de producción con HTTPS para forzar cookies seguras.
DJANGO_SECURE_COOKIES=0
